#!/usr/bin/env python3
"""OpenHands PostgreSQL Manager. Host-side only; no Docker access in agents."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import re
import secrets
import stat
import subprocess
import sys
import time
import urllib.error
import urllib.request
import urllib.parse
import uuid

BASE = Path(os.getenv("OH_PG_BASE", "/opt/openhands-postgres"))
STATE = BASE / "managed.json"
PG = os.getenv("OH_PG_CONTAINER", "openhands-postgres")
PREFIX = "agent-server-conversation-"
HOST = os.getenv("OH_PG_HOST", "172.17.0.1")
PORT = os.getenv("OH_PG_PORT", "55432")
DEST = "/tmp/openhands-postgres.env"
API = os.getenv("OH_PG_API", "http://127.0.0.1:18000/api/conversations/")
KEY = Path(os.getenv("OH_PG_API_KEY_FILE", "/root/.openhands/agent-canvas/api-key.txt"))
GRACE = max(300, int(os.getenv("OH_PG_GRACE_SECONDS", "300")))

def run(argv, *, data=None, env=None):
    return subprocess.run(argv, input=data, text=True, capture_output=True,
                          check=True, env=env).stdout.strip()

def pg(sql):
    return run(["docker", "exec", "-i", PG, "psql", "-X", "-U", "postgres",
                "-d", "postgres", "-At", "-v", "ON_ERROR_STOP=1"], data=sql)

def ident(cid):
    if re.fullmatch(r"[0-9a-f]{64}", cid) is None:
        raise ValueError("invalid container ID")
    return "oh_" + hashlib.sha256(cid.encode()).hexdigest()[:16]

def sq(value):
    if not re.fullmatch(r"[a-z0-9_]{1,63}", value):
        raise ValueError("invalid SQL identifier")
    return "'" + value + "'"

def checked_dir():
    if not BASE.is_dir() or BASE.is_symlink() or stat.S_IMODE(BASE.stat().st_mode) != 0o700:
        raise RuntimeError("credentials directory must be a real 0700 directory")

def read_state():
    if not STATE.exists():
        return {}
    if STATE.is_symlink() or stat.S_IMODE(STATE.stat().st_mode) != 0o600:
        raise RuntimeError("unsafe state file")
    obj = json.loads(STATE.read_text())
    if not isinstance(obj, dict):
        raise RuntimeError("invalid state file")
    return obj

def save_state(obj):
    tmp = BASE / ("managed." + secrets.token_hex(8) + ".tmp")
    fd = os.open(tmp, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
    try:
        with os.fdopen(fd, "w") as f:
            json.dump(obj, f, sort_keys=True, indent=2)
            f.write("\n")
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, STATE)
        dirfd = os.open(BASE, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(dirfd)
        finally:
            os.close(dirfd)
    finally:
        tmp.unlink(missing_ok=True)

def persistent_id_from_inspect(info):
    """Use the conversation bind mount, never the ephemeral container name."""
    matches = []
    for mount in info.get("Mounts", []):
        if mount.get("Destination", "").startswith("/var/openhands/conversations/"):
            dest = mount["Destination"].rsplit("/", 1)[-1]
            source = mount.get("Source", "").rsplit("/", 1)[-1]
            if re.fullmatch(r"[0-9a-f]{32}", dest) and dest == source:
                matches.append(str(uuid.UUID(hex=dest)))
    if len(matches) != 1:
        raise RuntimeError("cannot uniquely map runtime to persistent conversation")
    return matches[0]


def containers(all_containers=False):
    args = ["docker", "ps"]
    if all_containers:
        args.append("-a")
    args += ["--format", "{{.Names}}"]
    found = {}
    for name in run(args).splitlines():
        if not name.startswith(PREFIX):
            continue
        # Verify the runtime name is OpenHands-shaped but never treat it as its identity.
        try:
            uuid.UUID(name[len(PREFIX):])
        except ValueError:
            continue
        info = json.loads(run(["docker", "inspect", name]))[0]
        cid = info["Id"]
        if re.fullmatch(r"[0-9a-f]{64}", cid):
            found[cid] = (name, persistent_id_from_inspect(info))
    return found


def validated_conversation(conv):
    if not KEY.is_file() or KEY.is_symlink():
        raise RuntimeError("OpenHands API key unavailable")
    secret = KEY.read_text().strip()
    if not secret:
        raise RuntimeError("OpenHands API authentication key is empty")
    status = api_status(conv, secret)
    if status != 200:
        raise RuntimeError(f"OpenHands conversation API not ready (HTTP {status})")


def record_for_conversation(state, conv, cid):
    key = "conv:" + conv
    if key in state:
        entry = state[key]
        if entry.get("conversation") != conv:
            raise RuntimeError("conversation state mismatch")
        return key, entry
    # Adopt a tracked legacy runtime only while that exact runtime remains
    # present and its mount and API identity have been verified.
    legacy = state.get(cid)
    if legacy:
        if legacy.get("role") != ident(cid):
            raise RuntimeError("legacy state role mismatch")
        return key, {"conversation": conv, "role": legacy["role"],
                     "credential_file": cid + ".env",
                     "created_at": legacy.get("created_at", int(time.time())),
                     "absent_since": None}
    return key, {"conversation": conv, "role": "oh_" + hashlib.sha256(conv.encode()).hexdigest()[:16],
                 "credential_file": "conversation-" + conv.replace("-", "") + ".env",
                 "created_at": int(time.time()), "absent_since": None}

def db_status(role):
    r = pg(f"SELECT count(*) FROM pg_roles WHERE rolname={sq(role)} AND rolcanlogin AND NOT rolsuper AND NOT rolcreatedb AND NOT rolcreaterole AND NOT rolreplication;")
    d = pg(f"SELECT count(*) FROM pg_database d JOIN pg_roles r ON d.datdba=r.oid WHERE d.datname={sq(role)} AND r.rolname={sq(role)};")
    return r == "1", d == "1"

def credential_path(filename):
    if not re.fullmatch(r"(?:[0-9a-f]{64}|conversation-[0-9a-f]{32})\.env", filename):
        raise ValueError("invalid credential filename")
    return BASE / filename

def credentials(filename, role):
    path = credential_path(filename)
    if path.is_symlink():
        raise RuntimeError("credential symlink")
    if path.exists():
        if not path.is_file() or stat.S_IMODE(path.stat().st_mode) != 0o600:
            raise RuntimeError("credential mode not 0600")
        config = dict(line.split("=", 1) for line in path.read_text().splitlines())
        expected = {"PGHOST": HOST, "PGPORT": PORT, "PGDATABASE": role, "PGUSER": role}
        if any(config.get(k) != v for k,v in expected.items()) or not re.fullmatch(r"[0-9a-f]{64}", config.get("PGPASSWORD", "")):
            raise RuntimeError("invalid existing credentials")
        return path, config["PGPASSWORD"]
    password = secrets.token_hex(32)
    data = f"PGHOST={HOST}\nPGPORT={PORT}\nPGDATABASE={role}\nPGUSER={role}\nPGPASSWORD={password}\n"
    fd = os.open(path, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(data)
        f.flush()
        os.fsync(f.fileno())
    return path, password

def authentication(role, password):
    # Pass password through subprocess environment, never through logs or command arguments.
    env = dict(os.environ, PGPASSWORD=password)
    result = run(["docker", "exec", "-e", "PGPASSWORD", PG, "psql", "-X",
                  "-h", "127.0.0.1", "-p", "5432", "-U", role, "-d", role,
                  "-At", "-v", "ON_ERROR_STOP=1",
                  "-c", "SELECT current_database(),current_user;"], env=env)
    if result != role + "|" + role:
        raise RuntimeError("database identity mismatch")

def remote_present(name):
    result = subprocess.run(["docker", "exec", name, "test", "-e", DEST],
                            capture_output=True)
    if result.returncode not in (0, 1):
        raise RuntimeError("could not inspect agent credentials")
    return result.returncode == 0

def provision_one(cid, name, conv, state):
    validated_conversation(conv)
    key, entry = record_for_conversation(state, conv, cid)
    role = entry["role"]
    path, password = credentials(entry["credential_file"], role)
    role_ok, db_ok = db_status(role)
    if not role_ok and not db_ok:
        pg(f"CREATE ROLE {role} LOGIN PASSWORD '{password}' NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION CONNECTION LIMIT 20;")
        role_ok = True
    if role_ok and not db_ok:
        try:
            result = run(["docker", "exec", "-e", "PGPASSWORD", PG, "psql", "-X",
                          "-h", "127.0.0.1", "-p", "5432", "-U", role, "-d", "postgres",
                          "-At", "-c", "SELECT current_user;"],
                         env=dict(os.environ, PGPASSWORD=password))
        except subprocess.CalledProcessError:
            raise RuntimeError("role password not verified; manual recovery required")
        if result != role:
            raise RuntimeError("role authentication mismatch")
        pg(f"CREATE DATABASE {role} OWNER {role} CONNECTION LIMIT 20;")
    elif not role_ok and db_ok:
        raise RuntimeError("invalid database owner")
    pg(f"REVOKE ALL ON DATABASE {role} FROM PUBLIC;")
    authentication(role, password)
    if remote_present(name):
        remote = run(["docker", "exec", name, "sha256sum", DEST]).split()[0]
        if remote != hashlib.sha256(path.read_bytes()).hexdigest():
            raise RuntimeError("existing runtime credentials differ; refuse overwrite")
    else:
        run(["docker", "cp", str(path), f"{name}:{DEST}"])
    if run(["docker", "exec", name, "stat", "-c", "%a", DEST]) != "600":
        raise RuntimeError("agent credentials not mode 0600")
    validated_conversation(conv)
    state[key] = entry
    if cid in state and cid != key:
        # Retain legacy evidence but avoid treating the same database as two
        # independent cleanup candidates.
        state[cid]["migrated_to"] = key
    state[key]["absent_since"] = None
    save_state(state)
    print("READY", conv, role)


def runtime_record_key(cid):
    ident(cid)  # Validates Docker's immutable full container ID.
    return "runtime:" + cid


def runtime_provision(cid, name, conv, state):
    """Each Docker runtime owns one disposable database, never its conversation."""
    validated_conversation(conv)
    key = runtime_record_key(cid)
    if key in state:
        entry = state[key]
        if entry.get("role") != ident(cid) or entry.get("credential_file") != cid + ".env":
            raise RuntimeError("runtime state mismatch")
    else:
        # An older persistent-conversation deployment may already have
        # populated this exact container. Never replace its credentials.
        if remote_present(name):
            print("LEGACY_RUNTIME_KEEP", name, "existing credentials unchanged")
            return
        entry = {"role": ident(cid), "credential_file": cid + ".env",
                 "conversation": conv, "created_at": int(time.time()),
                 "absent_since": None}
    role = ident(cid)
    path, password = credentials(entry["credential_file"], role)
    role_ok, db_ok = db_status(role)
    if not role_ok and not db_ok:
        pg(f"CREATE ROLE {role} LOGIN PASSWORD '{password}' NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION CONNECTION LIMIT 20;")
        role_ok = True
    if role_ok and not db_ok:
        try:
            check = run(["docker", "exec", "-e", "PGPASSWORD", PG, "psql", "-X",
                         "-h", "127.0.0.1", "-p", "5432", "-U", role, "-d", "postgres",
                         "-At", "-c", "SELECT current_user;"],
                        env=dict(os.environ, PGPASSWORD=password))
        except subprocess.CalledProcessError:
            raise RuntimeError("role password not verified")
        if check != role:
            raise RuntimeError("role identity not verified")
        pg(f"CREATE DATABASE {role} OWNER {role} CONNECTION LIMIT 20;")
    elif not role_ok and db_ok:
        raise RuntimeError("unexpected database ownership")
    pg(f"REVOKE ALL ON DATABASE {role} FROM PUBLIC;")
    authentication(role, password)
    if remote_present(name):
        digest = run(["docker", "exec", name, "sha256sum", DEST]).split()[0]
        if digest != hashlib.sha256(path.read_bytes()).hexdigest():
            raise RuntimeError("runtime credentials differ; not overwriting")
    else:
        run(["docker", "cp", str(path), f"{name}:{DEST}"])
    if run(["docker", "exec", name, "stat", "-c", "%a", DEST]) != "600":
        raise RuntimeError("invalid runtime credential permissions")
    entry["absent_since"] = None
    state[key] = entry
    save_state(state)
    print("READY_RUNTIME", name, role)


def docker_snapshot():
    """Require the daemon to be reachable before trusting absent containers."""
    run(["docker", "info", "--format", "{{.ID}}"])
    # Validated Docker inspect/mount mapping is used for provisioning; cleanup
    # only needs the full IDs of all running and stopped containers.
    return set(run(["docker", "ps", "-a", "--no-trunc",
                    "--format", "{{.ID}}"]).splitlines())


def runtime_cleanup(state, apply=False):
    """Cleanup only manager-created runtime records, never older state."""
    present = docker_snapshot()
    now = int(time.time())
    dropped = 0
    for key, entry in list(state.items()):
        if not key.startswith("runtime:"):
            continue
        cid = key[len("runtime:"):]
        role = ident(cid)
        if entry.get("role") != role or entry.get("credential_file") != cid + ".env":
            raise RuntimeError("runtime cleanup identity mismatch")
        if cid in present:
            if entry.get("absent_since") is not None and apply:
                entry["absent_since"] = None
                save_state(state)
            print("KEEP_RUNTIME", cid[:12], role)
            continue
        if entry.get("absent_since") is None:
            print("ABSENT_FIRST_SEEN", cid[:12], role)
            if apply:
                entry["absent_since"] = now
                save_state(state)
            continue
        since = entry["absent_since"]
        if type(since) is not int or since > now or since < entry["created_at"]:
            raise RuntimeError("invalid absence timestamp")
        if now - since < GRACE:
            print("RETAIN_GRACE", cid[:12], role)
            continue
        # Existing persistent-conversation or legacy references are protected.
        if any(other_key != key and item.get("role") == role
               for other_key, item in state.items()):
            print("KEEP_ALIASED", cid[:12], role)
            continue
        if not apply:
            print("WOULD_DELETE_RUNTIME", cid[:12], role)
            continue
        if dropped >= 1:
            print("KEEP_RATE_LIMIT", cid[:12], role)
            continue
        if cid in docker_snapshot():
            print("KEEP_REAPPEARED", cid[:12], role)
            continue
        if db_status(role) != (True, True):
            raise RuntimeError("unverified database ownership")
        path = credential_path(entry["credential_file"])
        if not path.is_file() or path.is_symlink() or stat.S_IMODE(path.stat().st_mode) != 0o600:
            raise RuntimeError("unsafe or missing tracked credentials")
        # Do not automatically drop a runtime whose database is still in use.
        sessions = pg(
            f"SELECT count(*) FROM pg_stat_activity WHERE datname={sq(role)} "
            "AND pid <> pg_backend_pid();"
        )
        if sessions != "0":
            print("KEEP_CONNECTED", cid[:12], role)
            continue
        if cid in docker_snapshot():
            print("KEEP_REAPPEARED", cid[:12], role)
            continue
        pg(f"DROP DATABASE {role};")
        pg(f"DROP ROLE {role};")
        path.unlink()
        del state[key]
        save_state(state)
        dropped += 1
        print("DELETED_RUNTIME", cid[:12], role)


def api_status(conv, secret):
    req = urllib.request.Request(API.rstrip("/") + "/" + conv,
                                 headers={"X-Session-API-Key": secret})
    try:
        with urllib.request.urlopen(req, timeout=8) as response:
            return response.status
    except urllib.error.HTTPError as exc:
        if exc.code in (401, 403, 404):
            return exc.code
        raise RuntimeError("unexpected API status")

def conversation_catalog(secret):
    """Retrieve the entire authenticated persistent-conversation catalog."""
    if not secret:
        raise RuntimeError("missing API credentials")
    api_root = API.rstrip("/")
    next_page = None
    seen_pages = set()
    conversations = set()
    for _ in range(1000):
        params = {"limit": "100"}
        if next_page is not None:
            if next_page in seen_pages:
                raise RuntimeError("repeated conversation catalog cursor")
            seen_pages.add(next_page)
            params["page_id"] = next_page
        url = api_root + "/search?" + urllib.parse.urlencode(params)
        request = urllib.request.Request(
            url, headers={"X-Session-API-Key": secret}
        )
        with urllib.request.urlopen(request, timeout=8) as response:
            if response.status != 200:
                raise RuntimeError("conversation catalog not authenticated")
            data = json.load(response)
        if not isinstance(data, dict) or not isinstance(data.get("items"), list):
            raise RuntimeError("invalid conversation catalog payload")
        for item in data["items"]:
            if not isinstance(item, dict) or not isinstance(item.get("id"), str):
                raise RuntimeError("invalid conversation catalog record")
            conv = item["id"]
            if str(uuid.UUID(conv)) != conv:
                raise RuntimeError("noncanonical conversation ID in catalog")
            if conv in conversations:
                raise RuntimeError("duplicate conversation across catalog pages")
            conversations.add(conv)
        next_page = data.get("next_page_id")
        if next_page is None:
            return conversations
        if not isinstance(next_page, str) or not next_page:
            raise RuntimeError("invalid conversation catalog cursor")
    raise RuntimeError("conversation catalog exceeds safe pagination limit")


def cleanup(state, apply=False):
    if not KEY.is_file() or KEY.is_symlink():
        print("SKIP cleanup: no safe authenticated API key configured")
        return
    secret = KEY.read_text().strip()
    if not secret:
        print("SKIP cleanup: missing API credentials")
        return
    # Authenticate and fully paginate the persistent catalog. A runtime is
    # NOT required: OpenHands can suspend every container without deleting chats.
    catalog = conversation_catalog(secret)
    if not catalog or not any(api_status(conv, secret) == 200 for conv in sorted(catalog)[:5]):
        print("SKIP cleanup: catalog positive-control verification failed")
        return
    all_runtime_conversations = {conv for _, conv in containers(True).values()}
    now = int(time.time())
    deleted_this_run = 0
    for cid, entry in list(state.items()):
        if not cid.startswith("conv:"):
            continue  # Never automatically delete legacy runtime-keyed state.
        conv = entry.get("conversation")
        if not isinstance(conv, str) or cid != "conv:" + conv:
            raise RuntimeError("invalid persistent conversation state")
        if conv in catalog or conv in all_runtime_conversations:
            if entry.get("absent_since") is not None and apply:
                entry["absent_since"] = None
                save_state(state)
            print("KEEP", conv, "conversation present")
            continue
        # A missing catalog item is not sufficient: require a second
        # authenticated point lookup returning 404.
        status = api_status(conv, secret)
        if status != 404:
            if entry.get("absent_since") is not None and apply:
                entry["absent_since"] = None
                save_state(state)
            print("KEEP", conv, "API", status)
            continue
        if entry.get("absent_since") is None:
            print("KEEP", conv, "first confirmed API absence")
            if apply:
                entry["absent_since"] = now
                save_state(state)
            continue
        if not isinstance(entry["absent_since"], int) or entry["absent_since"] > now:
            raise RuntimeError("invalid retention timestamp")
        if now - entry["absent_since"] < GRACE:
            print("KEEP", conv, "24-hour safety period")
            continue
        role = entry.get("role")
        if not isinstance(role, str) or not re.fullmatch(r"oh_[0-9a-f]{16}", role):
            raise RuntimeError("invalid managed database role")
        if not apply:
            print("WOULD_DELETE", conv, role)
            continue
        # Conservative rate limit. Never bulk-drop all databases after a
        # transient API/storage failure.
        if deleted_this_run >= 1:
            print("KEEP", conv, "deletion rate limit")
            continue
        # Second full catalog and Docker check immediately before deletion.
        if conv in conversation_catalog(secret):
            print("KEEP", conv, "conversation reappeared")
            continue
        if conv in {c for _, c in containers(True).values()} or api_status(conv, secret) != 404:
            print("KEEP", conv, "changed during final check")
            continue
        if db_status(role) != (True, True):
            raise RuntimeError("database ownership check failed")
        # Migrated legacy records can still refer to this role.
        aliases = [key for key, value in state.items()
                   if key != cid and value.get("role") == role]
        if aliases:
            print("KEEP", conv, "role has legacy or duplicate state references")
            continue
        path = credential_path(entry.get("credential_file", ""))
        if not path.is_file() or path.is_symlink():
            raise RuntimeError("tracked credentials missing or unsafe")
        pg(f"DROP DATABASE {role} WITH (FORCE);")
        pg(f"DROP ROLE {role};")
        path.unlink()
        del state[cid]
        save_state(state)
        deleted_this_run += 1
        print("DELETED", conv, role)


def managed_inventory(state):
    """Read-only inventory; untracked databases are not deletion candidates."""
    rows = pg(
        "SELECT datname FROM pg_database "
        "WHERE datname ~ '^oh_[0-9a-f]{12,16}$' ORDER BY datname;"
    )
    databases = set(rows.splitlines()) if rows else set()
    references = {}
    for key, entry in state.items():
        role = entry.get("role")
        if isinstance(role, str) and re.fullmatch(r"oh_[0-9a-f]{12,16}", role):
            references.setdefault(role, []).append(key)
    return databases, references


def audit(state):
    """Report database classification without changing data or credentials."""
    databases, references = managed_inventory(state)
    active = {conv for _, conv in containers(True).values()}
    for role in sorted(databases | references.keys()):
        keys = references.get(role, [])
        if not keys:
            classification = "UNTRACKED_KEEP"
        elif any(key.startswith("runtime:") for key in keys):
            present = docker_snapshot()
            ids = [key[len("runtime:"):] for key in keys if key.startswith("runtime:")]
            classification = ("RUNTIME_KEEP" if any(cid in present for cid in ids)
                              else "RUNTIME_ABSENT_REVIEW")
        elif any(key.startswith("conv:") for key in keys):
            conversations = [key[5:] for key in keys if key.startswith("conv:")]
            classification = ("ACTIVE_KEEP" if any(conv in active for conv in conversations)
                              else "TRACKED_KEEP")
        else:
            classification = "LEGACY_KEEP"
        if role not in databases:
            classification = "MISSING_DB_REVIEW"
        print(classification, role, "records=" + str(len(keys)))
    print("Audit is read-only; no database is eligible for deletion based on this report.")



def event_action(event):
    """Map only OpenHands container lifecycle events to manager actions."""
    if not isinstance(event, dict) or event.get("Type") != "container":
        return None
    name = event.get("Actor", {}).get("Attributes", {}).get("name")
    if not isinstance(name, str) or not name.startswith(PREFIX):
        return None
    try:
        uuid.UUID(name[len(PREFIX):])
    except ValueError:
        return None
    return {"start": "provision", "destroy": "cleanup"}.get(event.get("Action"))


def trigger_manager(action):
    """Use the same lock as both timers; missed events are reconciled later."""
    if action not in ("provision", "cleanup"):
        raise ValueError("invalid lifecycle action")
    argv = ["/usr/bin/flock", "-w", "20", "/run/openhands-postgres-manager.lock",
            "/usr/local/sbin/openhands-postgres-manager", action]
    env = os.environ.copy()
    if action == "cleanup":
        argv.append("--apply")
        env["OH_PG_ENABLE_DELETION"] = "I_UNDERSTAND"
    attempts = 3 if action == "provision" else 1
    for attempt in range(attempts):
        result = subprocess.run(argv, env=env, timeout=150, check=False)
        if result.returncode == 0:
            return
        if attempt + 1 < attempts:
            # The OpenHands API can lag behind Docker's start event.
            time.sleep(3)
    print("WATCH_ACTION_RETRY_BY_TIMER", action, "status", result.returncode,
          flush=True)


def watch_events():
    """Long-running Docker event consumer, backed by both periodic timers."""
    # Docker's event stream follows new events; the timers reconcile missed ones.
    cmd = ["docker", "events", "--format", "{{json .}}",
           "--filter", "type=container",
           "--filter", "event=start", "--filter", "event=destroy"]
    with subprocess.Popen(cmd, stdout=subprocess.PIPE,
                          stderr=subprocess.DEVNULL, text=True, bufsize=1) as proc:
        for line in proc.stdout:
            try:
                event = json.loads(line)
                action = event_action(event)
            except (ValueError, TypeError, AttributeError):
                continue
            if action:
                print("WATCH_EVENT", action, flush=True)
                trigger_manager(action)
        raise RuntimeError("Docker event stream ended; systemd will restart watcher")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("action", choices=["status", "provision", "cleanup", "audit", "watch"])
    parser.add_argument("--apply", action="store_true", help="Apply cleanup after safety checks")
    args = parser.parse_args()
    if os.geteuid() != 0:
        raise RuntimeError("run as root on the OpenHands host")
    if args.action == "watch":
        watch_events()
        return
    checked_dir()
    health = run(["docker", "inspect", "-f",
                  "{{if .State.Health}}{{.State.Health.Status}}{{end}}", PG])
    if health != "healthy":
        raise RuntimeError("PostgreSQL is not healthy")
    state = read_state()
    if args.action == "status":
        print("Managed databases:", len(state))
        print("Running conversations:", len(containers()))
    elif args.action == "audit":
        audit(state)
    elif args.action == "provision":
        errors = 0
        for cid, (name, conv) in containers().items():
            try:
                runtime_provision(cid, name, conv, state)
            except Exception as exc:
                # Only print messages constructed by this program. External
                # subprocess errors may contain passwords or SQL statements.
                reason = (str(exc) if type(exc) is RuntimeError
                          else type(exc).__name__)
                print(f"ERROR {name}: {reason[:110]}", file=sys.stderr)
                errors += 1
        if errors:
            raise RuntimeError(f"{errors} provisioning errors")
    elif args.apply and os.getenv("OH_PG_ENABLE_DELETION") != "I_UNDERSTAND":
        raise RuntimeError("deletion requires OH_PG_ENABLE_DELETION=I_UNDERSTAND")
    else:
        runtime_cleanup(state, args.apply)


if __name__ == "__main__":
    try:
        main()
    except Exception as exc:
        print(f"FAILED: {type(exc).__name__}: {str(exc)[:120]}", file=sys.stderr)
        sys.exit(1)
