#!/usr/bin/env python3
"""OpenHands PostgreSQL Manager. Host-side only; no Docker access in agents."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import re
import secrets
import stat
import subprocess
import sys
import time
import urllib.error
import urllib.request
import uuid

BASE = Path(os.getenv("OH_PG_BASE", "/opt/openhands-postgres"))
STATE = BASE / "managed.json"
PG = os.getenv("OH_PG_CONTAINER", "openhands-postgres")
PREFIX = "agent-server-conversation-"
HOST = os.getenv("OH_PG_HOST", "172.17.0.1")
PORT = os.getenv("OH_PG_PORT", "55432")
DEST = "/tmp/openhands-postgres.env"
API = os.getenv("OH_PG_API", "http://127.0.0.1:18000/api/conversations/")
KEY = Path(os.getenv("OH_PG_API_KEY_FILE", "/root/.openhands/agent-canvas/api-key.txt"))
GRACE = int(os.getenv("OH_PG_GRACE_SECONDS", "86400"))

def run(argv, *, data=None, env=None):
    return subprocess.run(argv, input=data, text=True, capture_output=True,
                          check=True, env=env).stdout.strip()

def pg(sql):
    return run(["docker", "exec", "-i", PG, "psql", "-X", "-U", "postgres",
                "-d", "postgres", "-At", "-v", "ON_ERROR_STOP=1"], data=sql)

def ident(cid):
    if re.fullmatch(r"[0-9a-f]{64}", cid) is None:
        raise ValueError("invalid container ID")
    return "oh_" + hashlib.sha256(cid.encode()).hexdigest()[:16]

def sq(value):
    if not re.fullmatch(r"[a-z0-9_]{1,63}", value):
        raise ValueError("invalid SQL identifier")
    return "'" + value + "'"

def checked_dir():
    if not BASE.is_dir() or BASE.is_symlink() or stat.S_IMODE(BASE.stat().st_mode) != 0o700:
        raise RuntimeError("credentials directory must be a real 0700 directory")

def read_state():
    if not STATE.exists():
        return {}
    if STATE.is_symlink() or stat.S_IMODE(STATE.stat().st_mode) != 0o600:
        raise RuntimeError("unsafe state file")
    obj = json.loads(STATE.read_text())
    if not isinstance(obj, dict):
        raise RuntimeError("invalid state file")
    return obj

def save_state(obj):
    tmp = BASE / ("managed." + secrets.token_hex(8) + ".tmp")
    fd = os.open(tmp, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
    try:
        with os.fdopen(fd, "w") as f:
            json.dump(obj, f, sort_keys=True, indent=2)
            f.write("\n")
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, STATE)
        dirfd = os.open(BASE, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(dirfd)
        finally:
            os.close(dirfd)
    finally:
        tmp.unlink(missing_ok=True)

def persistent_id_from_inspect(info):
    """Use the conversation bind mount, never the ephemeral container name."""
    matches = []
    for mount in info.get("Mounts", []):
        if mount.get("Destination", "").startswith("/var/openhands/conversations/"):
            dest = mount["Destination"].rsplit("/", 1)[-1]
            source = mount.get("Source", "").rsplit("/", 1)[-1]
            if re.fullmatch(r"[0-9a-f]{32}", dest) and dest == source:
                matches.append(str(uuid.UUID(hex=dest)))
    if len(matches) != 1:
        raise RuntimeError("cannot uniquely map runtime to persistent conversation")
    return matches[0]


def containers(all_containers=False):
    args = ["docker", "ps"]
    if all_containers:
        args.append("-a")
    args += ["--format", "{{.Names}}"]
    found = {}
    for name in run(args).splitlines():
        if not name.startswith(PREFIX):
            continue
        # Verify the runtime name is OpenHands-shaped but never treat it as its identity.
        try:
            uuid.UUID(name[len(PREFIX):])
        except ValueError:
            continue
        info = json.loads(run(["docker", "inspect", name]))[0]
        cid = info["Id"]
        if re.fullmatch(r"[0-9a-f]{64}", cid):
            found[cid] = (name, persistent_id_from_inspect(info))
    return found


def validated_conversation(conv):
    if not KEY.is_file() or KEY.is_symlink():
        raise RuntimeError("OpenHands API key unavailable")
    secret = KEY.read_text().strip()
    if not secret or api_status(conv, secret) != 200:
        raise RuntimeError("persistent conversation not verified by authenticated API")


def record_for_conversation(state, conv, cid):
    key = "conv:" + conv
    if key in state:
        entry = state[key]
        if entry.get("conversation") != conv:
            raise RuntimeError("conversation state mismatch")
        return key, entry
    # Adopt a tracked legacy runtime only while that exact runtime remains
    # present and its mount and API identity have been verified.
    legacy = state.get(cid)
    if legacy:
        if legacy.get("role") != ident(cid):
            raise RuntimeError("legacy state role mismatch")
        return key, {"conversation": conv, "role": legacy["role"],
                     "credential_file": cid + ".env",
                     "created_at": legacy.get("created_at", int(time.time())),
                     "absent_since": None}
    return key, {"conversation": conv, "role": "oh_" + hashlib.sha256(conv.encode()).hexdigest()[:16],
                 "credential_file": "conversation-" + conv.replace("-", "") + ".env",
                 "created_at": int(time.time()), "absent_since": None}

def db_status(role):
    r = pg(f"SELECT count(*) FROM pg_roles WHERE rolname={sq(role)} AND rolcanlogin AND NOT rolsuper AND NOT rolcreatedb AND NOT rolcreaterole AND NOT rolreplication;")
    d = pg(f"SELECT count(*) FROM pg_database d JOIN pg_roles r ON d.datdba=r.oid WHERE d.datname={sq(role)} AND r.rolname={sq(role)};")
    return r == "1", d == "1"

def credential_path(filename):
    if not re.fullmatch(r"(?:[0-9a-f]{64}|conversation-[0-9a-f]{32})\.env", filename):
        raise ValueError("invalid credential filename")
    return BASE / filename

def credentials(filename, role):
    path = credential_path(filename)
    if path.is_symlink():
        raise RuntimeError("credential symlink")
    if path.exists():
        if not path.is_file() or stat.S_IMODE(path.stat().st_mode) != 0o600:
            raise RuntimeError("credential mode not 0600")
        config = dict(line.split("=", 1) for line in path.read_text().splitlines())
        expected = {"PGHOST": HOST, "PGPORT": PORT, "PGDATABASE": role, "PGUSER": role}
        if any(config.get(k) != v for k,v in expected.items()) or not re.fullmatch(r"[0-9a-f]{64}", config.get("PGPASSWORD", "")):
            raise RuntimeError("invalid existing credentials")
        return path, config["PGPASSWORD"]
    password = secrets.token_hex(32)
    data = f"PGHOST={HOST}\nPGPORT={PORT}\nPGDATABASE={role}\nPGUSER={role}\nPGPASSWORD={password}\n"
    fd = os.open(path, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(data)
        f.flush()
        os.fsync(f.fileno())
    return path, password

def authentication(role, password):
    # Pass password through subprocess environment, never through logs or command arguments.
    env = dict(os.environ, PGPASSWORD=password)
    result = run(["docker", "exec", "-e", "PGPASSWORD", PG, "psql", "-X",
                  "-h", "127.0.0.1", "-p", "5432", "-U", role, "-d", role,
                  "-At", "-v", "ON_ERROR_STOP=1",
                  "-c", "SELECT current_database(),current_user;"], env=env)
    if result != role + "|" + role:
        raise RuntimeError("database identity mismatch")

def remote_present(name):
    result = subprocess.run(["docker", "exec", name, "test", "-e", DEST],
                            capture_output=True)
    if result.returncode not in (0, 1):
        raise RuntimeError("could not inspect agent credentials")
    return result.returncode == 0

def provision_one(cid, name, conv, state):
    validated_conversation(conv)
    key, entry = record_for_conversation(state, conv, cid)
    role = entry["role"]
    path, password = credentials(entry["credential_file"], role)
    role_ok, db_ok = db_status(role)
    if not role_ok and not db_ok:
        pg(f"CREATE ROLE {role} LOGIN PASSWORD '{password}' NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION CONNECTION LIMIT 20;")
        role_ok = True
    if role_ok and not db_ok:
        try:
            result = run(["docker", "exec", "-e", "PGPASSWORD", PG, "psql", "-X",
                          "-h", "127.0.0.1", "-p", "5432", "-U", role, "-d", "postgres",
                          "-At", "-c", "SELECT current_user;"],
                         env=dict(os.environ, PGPASSWORD=password))
        except subprocess.CalledProcessError:
            raise RuntimeError("role password not verified; manual recovery required")
        if result != role:
            raise RuntimeError("role authentication mismatch")
        pg(f"CREATE DATABASE {role} OWNER {role} CONNECTION LIMIT 20;")
    elif not role_ok and db_ok:
        raise RuntimeError("invalid database owner")
    pg(f"REVOKE ALL ON DATABASE {role} FROM PUBLIC;")
    authentication(role, password)
    if remote_present(name):
        remote = run(["docker", "exec", name, "sha256sum", DEST]).split()[0]
        if remote != hashlib.sha256(path.read_bytes()).hexdigest():
            raise RuntimeError("existing runtime credentials differ; refuse overwrite")
    else:
        run(["docker", "cp", str(path), f"{name}:{DEST}"])
    if run(["docker", "exec", name, "stat", "-c", "%a", DEST]) != "600":
        raise RuntimeError("agent credentials not mode 0600")
    validated_conversation(conv)
    state[key] = entry
    if cid in state and cid != key:
        # Retain legacy evidence but avoid treating the same database as two
        # independent cleanup candidates.
        state[cid]["migrated_to"] = key
    state[key]["absent_since"] = None
    save_state(state)
    print("READY", conv, role)

def api_status(conv, secret):
    req = urllib.request.Request(API.rstrip("/") + "/" + conv,
                                 headers={"X-Session-API-Key": secret})
    try:
        with urllib.request.urlopen(req, timeout=8) as response:
            return response.status
    except urllib.error.HTTPError as exc:
        if exc.code in (401, 403, 404):
            return exc.code
        raise RuntimeError("unexpected API status")

def cleanup(state, apply=False):
    active = containers()
    if not active:
        print("SKIP cleanup: no running conversation for positive API control")
        return
    if not KEY.is_file() or KEY.is_symlink():
        print("SKIP cleanup: no safe authenticated API key configured")
        return
    secret = KEY.read_text().strip()
    # Require a verified 200 from the same authenticated API before trusting 404 as deletion.
    # The Docker runtime UUID and persisted conversation UUID may not be identical;
    # if they differ, cleanup safely stays disabled until mapping is implemented.
    if not secret or not any(api_status(conv, secret) == 200 for _,conv in active.values()):
        print("SKIP cleanup: no valid positive API control")
        return
    all_conversations = {conv for _,conv in containers(True).values()}
    now = int(time.time())
    for cid, entry in list(state.items()):
        if not cid.startswith("conv:"):
            continue  # Unknown legacy mappings are retained indefinitely.
        conv = entry["conversation"]
        if conv in all_conversations:
            if entry.get("absent_since") is not None and apply:
                entry["absent_since"] = None
                save_state(state)
            continue
        status = api_status(conv, secret)
        if status != 404:
            if entry.get("absent_since") is not None and apply:
                entry["absent_since"] = None
                save_state(state)
            print("KEEP", conv, "API", status)
            continue
        if entry.get("absent_since") is None:
            print("KEEP", conv, "first confirmed API 404")
            if apply:
                entry["absent_since"] = now
                save_state(state)
            continue
        if now - entry["absent_since"] < GRACE:
            print("KEEP", conv, "grace period")
            continue
        role = entry["role"]
        if cid != "conv:" + conv or not re.fullmatch(r"oh_[0-9a-f]{16}", role):
            raise RuntimeError("state identity mismatch")
        if not apply:
            print("WOULD_DELETE", conv, role)
            continue
        if conv in {c for _,c in containers(True).values()} or api_status(conv, secret) != 404:
            print("KEEP", conv, "changed during final check")
            continue
        if db_status(role) != (True, True):
            raise RuntimeError("database ownership check failed")
        # Migrated legacy records can still refer to this role. Fail closed.
        aliases = [key for key, value in state.items()
                   if key != cid and value.get("role") == role]
        if aliases:
            print("KEEP", conv, "role has legacy or duplicate state references")
            continue
        pg(f"DROP DATABASE {role} WITH (FORCE);")
        pg(f"DROP ROLE {role};")
        credential_path(entry["credential_file"]).unlink(missing_ok=True)
        del state[cid]
        save_state(state)
        print("DELETED", conv, role)

def managed_inventory(state):
    """Read-only inventory; untracked databases are not deletion candidates."""
    rows = pg(
        "SELECT datname FROM pg_database "
        "WHERE datname ~ '^oh_[0-9a-f]{12,16}$' ORDER BY datname;"
    )
    databases = set(rows.splitlines()) if rows else set()
    references = {}
    for key, entry in state.items():
        role = entry.get("role")
        if isinstance(role, str) and re.fullmatch(r"oh_[0-9a-f]{12,16}", role):
            references.setdefault(role, []).append(key)
    return databases, references


def audit(state):
    """Report database classification without changing data or credentials."""
    databases, references = managed_inventory(state)
    active = {conv for _, conv in containers(True).values()}
    for role in sorted(databases | references.keys()):
        keys = references.get(role, [])
        if not keys:
            classification = "UNTRACKED_KEEP"
        elif any(key.startswith("conv:") for key in keys):
            conversations = [key[5:] for key in keys if key.startswith("conv:")]
            classification = ("ACTIVE_KEEP" if any(conv in active for conv in conversations)
                              else "TRACKED_KEEP")
        else:
            classification = "LEGACY_KEEP"
        if role not in databases:
            classification = "MISSING_DB_REVIEW"
        print(classification, role, "records=" + str(len(keys)))
    print("Audit is read-only; no database is eligible for deletion based on this report.")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("action", choices=["status", "provision", "cleanup", "audit"])
    parser.add_argument("--apply", action="store_true", help="Apply cleanup after safety checks")
    args = parser.parse_args()
    if os.geteuid() != 0:
        raise RuntimeError("run as root on the OpenHands host")
    checked_dir()
    health = run(["docker", "inspect", "-f",
                  "{{if .State.Health}}{{.State.Health.Status}}{{end}}", PG])
    if health != "healthy":
        raise RuntimeError("PostgreSQL is not healthy")
    state = read_state()
    if args.action == "status":
        print("Managed databases:", len(state))
        print("Running conversations:", len(containers()))
    elif args.action == "audit":
        audit(state)
    elif args.action == "provision":
        errors = 0
        for cid, (name, conv) in containers().items():
            try:
                provision_one(cid, name, conv, state)
            except Exception as exc:
                print(f"ERROR {name}: {type(exc).__name__}", file=sys.stderr)
                errors += 1
        if errors:
            raise RuntimeError(f"{errors} provisioning errors")
    elif args.apply and os.getenv("OH_PG_ENABLE_DELETION") != "I_UNDERSTAND":
        raise RuntimeError("deletion requires OH_PG_ENABLE_DELETION=I_UNDERSTAND")
    else:
        cleanup(state, args.apply)


if __name__ == "__main__":
    try:
        main()
    except Exception as exc:
        print(f"FAILED: {type(exc).__name__}: {str(exc)[:120]}", file=sys.stderr)
        sys.exit(1)
